# program cc_spi_loopback  (118 image bytes)
# source: ~/Documents/protocol-emulator/test/cocotb_tests/protocols.py:spi_master
# SPI master, 6-clock half period; CS uio0 MOSI uio1 MISO uio2 SCK uio3; MOSI looped to MISO, so every byte reads back

test mode_0_reads_back_what_it_sends
reset
drain 1
loop 00000900
cmds 
rx 0 4 200000 a53c817e

