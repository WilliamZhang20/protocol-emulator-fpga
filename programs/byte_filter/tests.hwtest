# program byte_filter  (84 image bytes)
# source: /home/wzhang20/Documents/protocol-emulator-compiler/examples/byte_filter.spt
# pins: tx=uio0, rx=uio1

test drop_nonmatching_packet_and_retain_subsequent_addressed_packets
reset
drain 2
loop 00000080
cmds 
packet 1 200000 2f02 0
packet 1 200000 2003 0
end
