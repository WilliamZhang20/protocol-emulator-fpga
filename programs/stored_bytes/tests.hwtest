# program stored_bytes  (143 image bytes)
# source: /home/wzhang20/Documents/protocol-emulator-compiler/examples/stored_bytes.spt
# pins: tx=uio0, unused_rx=uio1

test stored_bytes_stream_through_FIFO_backpressure_and_can_be_replayed
reset
drain 2
loop 00000000
cmds 
serial 64 0 1 none
cmds e1607060f0
reply 1 200000 - ok
sread 8 200000 00ff55a501020304
cmds e1617060f0
reply 1 200000 - ok
sread 8 200000 00ff55a501020304
cmds e1627060f0
reply 1 200000 - ok
sread 1 200000 a5
end
