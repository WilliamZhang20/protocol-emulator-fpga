// SPI controller for the KV260 board, on the Pmod SPI pins (Digilent / Tiny
// Tapeout top row): CS uio0, MOSI uio1, MISO uio2, SCK uio3. Mode 0, MSB first.
// Controller logic is protocol-emulator-compiler/examples/spi.spt; only the pin
// placement, the clock rate and the tests differ.

clock 50 MHz
const HALF = 25 cycles   // half an SCK period: 1 MHz, fine for flying wires

pin cs @ 0: out = cs_n
pin mosi @ 1: out = bits.out
pin miso @ 2: in
pin sck @ 3: out = sck_clock.out

event begin, finish

// CS is low from `begin` until `cs_off` ticks, half a period after the last edge.
reg selected = begin || (selected && !cs_off.tick)
reg cs_n init 1 = !selected

// Words may start until the transaction's last word has begun, so the fabric
// itself ends the transaction; bytes the host sends early for the next one wait.
counter sent { count: bits.word, clear: begin }
reg open = begin || (open && !(sent.at_least && bits.busy))

timer sck_clock { every: HALF, idle: 0, run: bits.busy until bits.done }
timer cs_off { every: HALF, pulse, run: finish until cs_off.tick }
timer gap { every: 4 cycles, pulse, run: cs_off.tick until gap.tick }

shifter bits {
    frame: [data(8, msb_first)],
    start: open,
    shift: sck_clock.fall,
    sample: miso at sck_clock.rise,
}

// One transaction: CS falls, `data` goes out while the reply comes in, CS rises.
export fn transfer(data: bytes via bits) -> bytes via bits {
    sent.limit = data.len - 1
    fire begin
    repeat data.len { wait bits.word }
    fire finish
    wait cs_off.tick
    wait gap.tick
}

always "SCK only moves while CS is low" { sck.changed implies cs == 0 }

// ─── tests ───────────────────────────────────────────────

test "loopback reads back what it sends" {
    wire mosi -> miso
    expect transfer([0xA5, 0x3C, 0x81, 0x7E]) == [0xA5, 0x3C, 0x81, 0x7E]
    expect transfer([0x00, 0xFF]) == [0x00, 0xFF]
}

// On the board `flash` is a real SPI NOR flash (see spi_board.board). MISO
// floats (pulled up) during the command byte, so the first reply is 0xFF.
// The ID below is Micron N25Q256 (Digilent Pmod SF3); edit it for your part.
test "reads a SPI flash JEDEC ID" {
    attach spi_device(cs: cs, sck: sck, mosi: mosi, miso: miso, mode: 0, replies: [0xFF, 0x20, 0xBA, 0x19]) as flash
    expect transfer([0x9F, 0x00, 0x00, 0x00]) == [0xFF, 0x20, 0xBA, 0x19]
}
