# 8N1 UART, 24 clocks/bit (2083333 baud); TXD uio1 -> RXD uio2

test internal_loopback_32_bytes
reset
drain 2
loop 00000900
cmds 
rx 1 32 200000 a54dca182530bb1d6d132cded6237b2ed91e3f721fcb1971174494d6493c9d5c

test stream_256_bytes_through_8_deep_fifos
reset
drain 2
loop 00000900
cmds 
rx 1 256 1000000 

