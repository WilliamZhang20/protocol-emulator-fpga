# program i2c_board  (514 image bytes)
# source: programs/spt/i2c_board.spt
# pins: scl=uio2, sda=uio3

test an_absent_address_is_reported
reset
drain 1
loop 00000000
cmds 
reply 0 200000 - 1

test reads_the_ADT7420_ID_register
needs i2c_adt7420 ADT7420 at 0x4B on SCL uio2 / SDA uio3, e.g. Digilent Pmod TMP2
reset
drain 1
loop 00000000
cmds 
reply 0 200000 cb ok
end
