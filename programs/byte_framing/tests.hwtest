# program byte_framing  (108 image bytes)
# source: /home/wzhang20/Documents/protocol-emulator-compiler/examples/byte_framing.spt
# pins: tx=uio0, rx=uio1

test packet_data_and_escapes_round_trip_with_checksum
reset
drain 2
loop 00000080
cmds 
packet 1 200000 7e7d0104 0
cmds e0627063f0
packet 1 200000 0203fb 0
cmds e062f8
packet 1 200000 827e 0

test independent_UART_peer_sees_exact_framed_and_escaped_bytes
reset
drain 2
loop 00000000
cmds 
serial 64 0 1 none
cmds e06e776d7761f0
sread 8 200000 7e7d5e7d5d01047e
cmds e062f8
sread 5 200000 7e827d5e7e

test bad_checksum_is_reported
reset
drain 2
loop 00000000
cmds 
serial 64 0 1 none
cmds 00ff003a
idle 200000
swrite 7e10007e
packet 1 200000 1000 1

test malformed_escape_is_reported_even_with_a_valid_checksum
reset
drain 2
loop 00000000
cmds 
serial 64 0 1 none
cmds 00ff003a
idle 200000
swrite 7e7d11ef7e
packet 1 200000 11ef 1
end
