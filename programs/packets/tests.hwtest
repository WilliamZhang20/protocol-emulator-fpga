# program packets  (111 image bytes)
# source: /home/wzhang20/Documents/protocol-emulator-compiler/examples/packets.spt
# pins: tx=uio0, rx=uio1

test two_packets_keep_their_boundaries
reset
drain 3
loop 00000080
cmds 
packet 0 200000 a53c 0
packet 0 200000 00ff81 0

test abort_a_partial_first_word_then_receive_a_fresh_packet
reset
drain 3
loop 00000080
cmds 
reply 1 200000 - ok
reply 1 200000 - ok
packet 0 200000 5a 0
end
