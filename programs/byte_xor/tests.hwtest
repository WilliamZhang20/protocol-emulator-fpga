# program byte_xor  (108 image bytes)
# source: /home/wzhang20/Documents/protocol-emulator-compiler/examples/byte_xor.spt
# pins: tx=uio0, rx=uio1

test independent_UART_peer_sees_the_XOR_checksum
reset
drain 2
loop 00000000
cmds 
serial 64 0 1 none
cmds e0627164f3
sread 3 200000 123426

test XOR_checksum_verifies_on_receive
reset
drain 2
loop 00000080
cmds 
packet 1 200000 123426 0

test bad_XOR_checksum_is_reported
reset
drain 2
loop 00000000
cmds 
serial 64 0 1 none
cmds 00ff003a
idle 200000
swrite 123400
packet 1 200000 123400 1
end
