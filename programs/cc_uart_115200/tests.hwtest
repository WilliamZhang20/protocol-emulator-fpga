# program cc_uart_115200  (60 image bytes)
# source: ~/Documents/protocol-emulator/test/cocotb_tests/protocols.py:uart_full_duplex
# 8N1 UART at 115200 baud (434 clocks/bit).
# Board: USB-UART adapter (3.3 V): adapter RX <- uio1 (chip TXD),
# adapter TX -> uio2 (chip RXD), GND <-> Pmod GND; open its COM port with pe_serial.

test chip_to_terminal_and_back
reset
drain 2
loop 00000000
cmds 10203040504050495241504157495e4050405046544050415b415041504f5a415043504050405042504e56435241514759425842514450405049514c5440504058425140504450415b41504550475d40504750405040504650405d435245514759425046514658415047514059405143514050485041534150405081
serial 434 1 2 none
cmds e0687665766c766c766f766072667662776f766d766072647768766576607263766876697660776d706a70
sread 21 250000 68656c6c6f2066726f6d2074686520636869700d0a
swrite 6f6b21
